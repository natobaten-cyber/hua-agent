  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npx ts-node-dev --respawn --transpile-only src/server/index.ts",
    "dev:client": "vite src/renderer --port 5173",
    "build": "tsc -p tsconfig.server.json && npx vite build",
    "start": "node dist/server/index.js"
  },
